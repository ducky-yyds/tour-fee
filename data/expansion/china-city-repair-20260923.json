    "guide": {
      "cityId": "yanan",
      "intro": "在窑洞院落和革命展馆里理解历史，再去宝塔山看延河，晚上留给老城的陕北小吃。",
      "foodHighlights": [
        {
          "name": "荞面饸饹",
          "description": "荞面压成细长面条，可搭配热汤和臊子。先问清楚汤底与肉类，再按一碗主食安排；这是一顿正餐，不只是尝一口的小吃。"
        },
        {
          "name": "洋芋擦擦",
          "description": "土豆擦成细条、拌面蒸熟，松散的口感很有陕北家常味。店家可再炒或拌调料，适合两人分一盘搭配其他菜。"
        },
        {
          "name": "子长煎饼",
          "description": "以荞麦面摊成的薄煎饼，常配不同馅料和蘸汁卷食。它与天津煎饼果子的厚薄、吃法都不同，可在延安市区寻找专做陕北小吃的店。"
        },
        {
          "name": "黄米馍馍",
          "description": "黄米做成的蒸制主食，带着杂粮的香气。早餐或正餐都可搭配，购买时询问甜咸与馅料；各家做法和大小不完全一样。"
        },
        {
          "name": "陕北油馍馍",
          "description": "糜子加工的米面经发酵、揉制后油炸，常做成中间有孔的环形。外层酥香、内部绵软，适合买一两个现做的慢慢尝。"
        }
      ],
      "neighborhoods": [
        {
          "name": "二道街夜市与老城小吃",
          "description": "晚上在老城挑几样陕北小吃，看看面食、杂粮和街边摊怎样融入当地人的日常。可以只散步，也可将原本的晚餐放到这里，不必再增加一份完整晚餐预算。"
        }
      ],
      "experienceIntro": "先选真正感兴趣的内容，再留出通勤、用餐和休息时间；小街区也能成为旅程中值得停留的一站。"
    },
