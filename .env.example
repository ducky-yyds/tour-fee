# Local source data and original assets are the canonical copy. Never commit actual credentials.
HOST=127.0.0.1
PORT=8787
# Defaults shown; use absolute paths when relocating storage on a production server.
TRAVEL_DB_PATH=data/travel.sqlite
ASSET_ARCHIVE_DIR=storage/originals
PROJECT_BACKUP_DIR=storage/backups
MEDIA_ROOT=public/images
# Optional public derivative-image CDN, never the private original-archive directory.
VITE_MEDIA_BASE_URL=
# Run maintain:local through the OS scheduler instead of two simultaneous maintenance writers.
AUTO_UPDATE=0
