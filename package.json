{
  "name": "tusuan-travel-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.mjs",
    "build": "node --env-file-if-exists=.env scripts/build-production.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "export:static": "node scripts/export-static-data.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "update:data": "node scripts/update-data.mjs",
    "maintain:local": "node --env-file-if-exists=.env scripts/maintain-local.mjs",
    "archive:assets": "node --env-file-if-exists=.env scripts/archive-assets.mjs",
    "archive:snapshot": "node --env-file-if-exists=.env scripts/archive-project.mjs snapshot",
    "archive:verify": "node --env-file-if-exists=.env scripts/archive-project.mjs verify",
    "archive:export": "node --env-file-if-exists=.env scripts/archive-project.mjs export",
    "archive:restore": "node --env-file-if-exists=.env scripts/archive-project.mjs restore",
    "export:public-snapshot": "node scripts/export-public-snapshot.mjs",
    "check:sources": "node scripts/check-source-health.mjs",
    "audit:experiences": "node scripts/audit-experiences.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "import:destinations": "node scripts/import-expansion.mjs --refresh",
    "update:images": "node scripts/fetch-images.mjs",
    "complete:images": "python scripts/complete-media.py",
    "update:stays": "python scripts/update-stay-library.py",
    "update:map": "node scripts/update-map.mjs",
    "update:airports": "node scripts/update-airports.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.8",
    "vite": "^7.1.5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
